#!/usr/bin/env bash

module purge
module load craype-x86-rome
module load libfabric
module load craype-network-ofi
module load craype
module load PrgEnv-intel
module load intel
module load cray-mpich
module load udunits
module load zlib
module load libjpeg

if [[ -d build ]]; then
    echo "build directory exists - hit enter to continue (<CNTL>-C to quit)"
    read resp
    echo "deleting existing build"
    rm -rf build
fi

(
    echo "==> create build directory"
    mkdir build
    cd build

    echo "==> loaded modules"
    module list

    echo "==> running cmake"
    cmake .. -DBUILD_PADCIRC=ON \
	    -DBUILD_ADCPREP=ON \
	    -DENABLE_DATETIME=ON \
	    -DENABLE_OUTPUT_NETCDF=ON \
	    -DNETCDFHOME=/apps/prod/hpc-stack/intel-19.1.3.304/cray-mpich-8.1.4/netcdf/4.7.4 \
	    -DCMAKE_Fortran_FLAGS_RELEASE="-g -traceback -O2 -xCORE-AVX2 -fp-model strict -fp-model source"
            -DCMAKE_C_FLAGS_RELEASE="-O2 -xCORE-AVX2 -w -nowarn" \
	    -DCMAKE_Fortran_FLAGS_RELEASE="-DVELCHECK" \
	    -DCMAKE_VERBOSE_MAKEFILE=ON

    echo "==> runnning make"
    make
) 2>&1 | tee "$(basename $0).out"
